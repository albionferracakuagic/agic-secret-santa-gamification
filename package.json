{
  "name": "santa-gamification",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && npm run build -w apps/web",
    "typecheck": "tsc -b && tsc -p apps/web && tsc -p e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "tsc -b && vitest run",
    "test:e2e": "npm run test -w e2e",
    "dev": "concurrently -k -n server,web \"npm run dev -w apps/server\" \"npm run dev -w apps/web\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
