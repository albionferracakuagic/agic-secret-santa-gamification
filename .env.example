# Copy to .env (never commit .env). In Azure these come from Key Vault via managed identity.
NODE_ENV=development
PORT=3000
# Omit to use a local PGlite database (.data/). Example: postgres://user:pass@localhost:5432/santa
DATABASE_URL=
# Must equal the URL in the browser's address bar (else sign-in fails with INVALID_ORIGIN).
# Standard `npm run dev` (Vite on :5173 proxies /api): http://localhost:5173
# Single-port prod-style: http://localhost:3000 + WEB_DIST=apps/web/dist
# Phones on LAN: http://<LAN-IP>:5173 and run vite with `--host`
BETTER_AUTH_URL=http://localhost:5173
# >= 32 random chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional social sign-in (organizers). Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
EMAIL_TRANSPORT=console

# Production: EMAIL_TRANSPORT=acs is mandatory (startup fails with console). Auth uses the managed identity.
# EMAIL_TRANSPORT=acs
# ACS_ENDPOINT=https://<resource>.<geo>.communication.azure.com
# ACS_SENDER_ADDRESS=DoNotReply@<verified-domain>
# Exact number of reverse-proxy hops in front of the server (Container Apps ingress = 1).
TRUST_PROXY_HOPS=1
# Serve the built SPA from this server (e.g. apps/web/dist). Unset = API only.
WEB_DIST=
# Comma-separated verified emails that are platform admins.
PLATFORM_ADMIN_EMAILS=
