# Copy to .env (never commit .env). In Azure these come from Key Vault via managed identity.
NODE_ENV=development
PORT=3000
# Omit to use a local PGlite database (.data/). Example: postgres://user:pass@localhost:5432/santa
DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
# >= 32 random chars; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Optional social sign-in (organizers). Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
EMAIL_TRANSPORT=console
